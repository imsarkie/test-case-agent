# Copy this file to .env and paste your real OpenRouter API key in.
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any OpenRouter model slug ending in ":free" works with a free-tier key.
# See https://openrouter.ai/models?max_price=0 for the current free list.
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Used only when --screenshots is passed — must be a vision-capable model.
# Free vision models change over time; check
# https://openrouter.ai/models?modality=text%2Bimage-%3Etext&max_price=0
# and update this if the one below is no longer free/available.
OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
